# Copy to ~/.config/wechatbot.env, then chmod 600 the real file.
# Use your current authorized ADB endpoint; do not copy an old device address.
ADB_SERIAL=
XAI_API_KEY=
MINIMAX_API_KEY=
KIMI_CODE_API_KEY=
ANTHROPIC_API_KEY=
# Optional Feishu integration (all three fields must refer to your application).
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TO_OPEN_ID=
WECHATBOT_BACKGROUND=1
ADB_USB_FALLBACK=
ADB_DEVICE_PROP=OnePlus9R
WECHAT_SELF_NAME=Bot Example
WECHAT_MENTION_ONLY_GROUPS=MentionOnly
WECHAT_CROSS_NAMES=
WECHAT_DISCOVERY_ALIASES={}
