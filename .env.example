# 复制成 ~/.config/wechatbot.env 并 chmod 600,填入你自己的值。
# ⚠️ 绝不要把真实 key 提交到仓库。

# —— LLM(至少配一个 MiniMax,其它按需)——
MINIMAX_API_KEY=
KIMI_CODE_API_KEY=          # 深度问答(可选)
ANTHROPIC_API_KEY=          # 联网深答 + 判敏兜底(可选)
XAI_API_KEY=                # Grok 视觉兜底(可选)
XAI_MODEL=grok-4.5

# —— 手机连接 ——
ADB_SERIAL=192.168.1.x:5555   # 手机 WiFi ADB 地址;或靠 mDNS 自动发现
ADB_USB_FALLBACK=             # adb devices 里的 USB serial,无线连不上时回退

# —— 飞书告警(可选,不配就不推送)——
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TO_OPEN_ID=            # 机主在你飞书自建应用下的 open_id
